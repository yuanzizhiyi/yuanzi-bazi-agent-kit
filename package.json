{
  "name": "yuanzi-bazi-agent-kit",
  "version": "0.1.0",
  "description": "Local-first deterministic Bazi chart core, CLI, MCP server, and Agent Skill by Yuanzi Zhiyi.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "bazi",
    "four-pillars",
    "mcp",
    "model-context-protocol",
    "agent-skill",
    "webmcp",
    "chinese-calendar"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wanghan198710-pixel/yuanzi-bazi-agent-kit.git"
  },
  "homepage": "https://github.com/wanghan198710-pixel/yuanzi-bazi-agent-kit#readme",
  "bugs": {
    "url": "https://github.com/wanghan198710-pixel/yuanzi-bazi-agent-kit/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "import": "./dist/mcp.js"
    }
  },
  "bin": {
    "yuanzi-bazi": "./dist/cli.js"
  },
  "files": [
    "dist/",
    "agents/",
    "references/",
    "SKILL.md",
    "LICENSE",
    "TRADEMARKS.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md",
    "README.md",
    "README.zh-CN.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsx --test tests/*.test.ts",
    "test:coverage": "c8 --check-coverage --lines 80 --functions 80 --branches 80 --statements 80 tsx --test tests/*.test.ts",
    "pack:check": "npm run build && npm pack --dry-run",
    "prepublishOnly": "npm run test:coverage && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "tyme4ts": "1.5.2",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "^22.14.0",
    "c8": "12.0.0",
    "tsx": "^4.20.6",
    "typescript": "~5.8.2"
  }
}
